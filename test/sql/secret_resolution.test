# name: test/sql/secret_resolution.test
# description: which delta_sharing secret a delta_share_* call resolves
# group: [sql]

require parquet

require duckdb_delta_sharing

# The sqllogictest runner skips a whole test file (rather than failing it) when
# the actual error contains "HTTP" or "Unable to connect" — a default meant to
# tolerate flaky CI networking. Every assertion below relies on curl's DNS
# failure message, which HTTPException wraps as "HTTP Error: ...", so the
# default would silently skip this entire file instead of failing it. Clear it.
set ignore_error_messages

# Every ENDPOINT is its own `.invalid` host (RFC 6761: never resolves), so a
# call fails offline with curl's "Could not resolve host: <host>" — the host
# names the secret the call resolved. Persistent secrets land in local_file
# storage (tie-break 20), standing in for an attached store against memory (10).

statement ok
SET secret_directory='__TEST_DIR__/secret_resolution';

# --- Default rule (no endpoint := / secret :=) ------------------------------

statement error
SELECT * FROM delta_share_list();
----
Please configure Delta Sharing via a secret

statement ok
CREATE SECRET alpha (TYPE delta_sharing, ENDPOINT 'https://alpha.invalid/ds', BEARER_TOKEN 'a');

statement error
SELECT * FROM delta_share_list();
----
Could not resolve host: alpha.invalid

# ① an unscoped secret beats a scoped one, whatever their names (aaa_scoped
# sorts before alpha, so a name-only tie-break would wrongly pick it)
statement ok
CREATE SECRET aaa_scoped (TYPE delta_sharing, ENDPOINT 'https://zeta.invalid/ds', BEARER_TOKEN 'z', SCOPE 'https://zeta.invalid/ds');

statement error
SELECT * FROM delta_share_list();
----
Could not resolve host: alpha.invalid

# ① between unscoped secrets, memory beats a persistent storage
statement ok
CREATE PERSISTENT SECRET aaa_stored (TYPE delta_sharing, ENDPOINT 'https://stored.invalid/ds', BEARER_TOKEN 's');

statement error
SELECT * FROM delta_share_list();
----
Could not resolve host: alpha.invalid

statement ok
DROP SECRET alpha;

statement error
SELECT * FROM delta_share_list();
----
Could not resolve host: stored.invalid

# ③ only scoped secrets, more than one: refuse rather than guess
statement ok
DROP PERSISTENT SECRET aaa_stored;

statement ok
CREATE SECRET yotta (TYPE delta_sharing, ENDPOINT 'https://yotta.invalid/ds', BEARER_TOKEN 'y', SCOPE 'https://yotta.invalid/ds');

statement error
SELECT * FROM delta_share_list();
----
2 delta_sharing secrets are scoped and none is unscoped (aaa_scoped, yotta)

# ② exactly one secret, even a scoped one: use it
statement ok
DROP SECRET yotta;

statement error
SELECT * FROM delta_share_list();
----
Could not resolve host: zeta.invalid

# delta_share_list_files (scalar: no named parameters) follows the same rule
statement error
SELECT delta_share_list_files('s', 'sc', 't');
----
Could not resolve host: zeta.invalid

statement ok
DROP SECRET aaa_scoped;

# CreateDeltaSharingSecretFromConfig only requires the 'endpoint' key be
# present, not non-empty — CREATE SECRET (... ENDPOINT '') succeeds. So the
# resolver must reject an empty ENDPOINT itself, before the endpoint := guard.
statement ok
CREATE SECRET empty_endpoint (TYPE delta_sharing, ENDPOINT '', BEARER_TOKEN 'x');

statement error
SELECT * FROM delta_share_list();
----
secret 'empty_endpoint' has no ENDPOINT

statement error
SELECT * FROM delta_share_list(endpoint := 'https://x.invalid/ds');
----
secret 'empty_endpoint' has no ENDPOINT

statement ok
DROP SECRET empty_endpoint;

# Omitting the 'endpoint' key entirely (not just leaving it empty) is still
# rejected at CREATE time.
statement error
CREATE SECRET omitted_endpoint (TYPE delta_sharing, BEARER_TOKEN 'x');
----
requires 'endpoint' parameter

# --- endpoint := (longest SCOPE prefix; requests go to the endpoint) ---------
# With endpoint :=, requests go to X whatever the secret, so these secrets'
# ENDPOINTs sit on elsewhere.invalid, which never covers X: the guard error
# then names the secret the lookup chose.

# The headline case the guard exists for: an unscoped secret matches every
# endpoint := (DuckDB's own scoring), so without the guard a lone secret's
# bearer token would be sent to any host the caller names.
statement ok
CREATE SECRET lone_unscoped (TYPE delta_sharing, ENDPOINT 'https://a.invalid/ds', BEARER_TOKEN 'x');

statement error
SELECT * FROM delta_share_list(endpoint := 'https://b.invalid/ds');
----
secret 'lone_unscoped' has ENDPOINT 'https://a.invalid/ds', which does not cover endpoint := 'https://b.invalid/ds'

statement ok
DROP SECRET lone_unscoped;

statement ok
CREATE SECRET aaa_wide (TYPE delta_sharing, ENDPOINT 'https://elsewhere.invalid/w', BEARER_TOKEN 'w', SCOPE 'https://shared.invalid/');

statement ok
CREATE SECRET narrow (TYPE delta_sharing, ENDPOINT 'https://elsewhere.invalid/n', BEARER_TOKEN 'n', SCOPE 'https://shared.invalid/ds');

statement error
SELECT * FROM delta_share_list(endpoint := 'https://shared.invalid/ds');
----
secret 'narrow' has ENDPOINT 'https://elsewhere.invalid/n', which does not cover endpoint := 'https://shared.invalid/ds'

statement ok
DROP SECRET aaa_wide;

statement ok
DROP SECRET narrow;

# A scoped match beats an unscoped secret, whatever the storage (pinned: this
# is DuckDB's scoring; to choose the unscoped secret here, pass secret :=).
statement ok
CREATE SECRET aaa_session_unscoped (TYPE delta_sharing, ENDPOINT 'https://elsewhere.invalid/u', BEARER_TOKEN 'u');

statement ok
CREATE PERSISTENT SECRET aaa_store_scoped (TYPE delta_sharing, ENDPOINT 'https://elsewhere.invalid/s', BEARER_TOKEN 's', SCOPE 'https://shared.invalid/ds');

statement error
SELECT * FROM delta_share_list(endpoint := 'https://shared.invalid/ds');
----
secret 'aaa_store_scoped'

# At equal SCOPE, memory beats a persistent storage
statement ok
CREATE SECRET session_scoped (TYPE delta_sharing, ENDPOINT 'https://elsewhere.invalid/m', BEARER_TOKEN 'm', SCOPE 'https://shared.invalid/ds');

statement error
SELECT * FROM delta_share_list(endpoint := 'https://shared.invalid/ds');
----
secret 'session_scoped'

statement ok
DROP SECRET session_scoped;

statement ok
DROP PERSISTENT SECRET aaa_store_scoped;

statement ok
DROP SECRET aaa_session_unscoped;

# The guard passes: requests go to the endpoint
statement ok
CREATE SECRET covered (TYPE delta_sharing, ENDPOINT 'https://covered.invalid/ds/', BEARER_TOKEN 'c', SCOPE 'https://covered.invalid/ds');

statement error
SELECT * FROM delta_share_list(endpoint := 'https://covered.invalid/ds');
----
Could not resolve host: covered.invalid

statement error
SELECT * FROM delta_share_list(endpoint := 'https://covered.invalid/ds/sub/');
----
Could not resolve host: covered.invalid

# Extending the ENDPOINT without a '/' boundary is not covered
statement error
SELECT * FROM delta_share_list(endpoint := 'https://covered.invalid/dsx');
----
which does not cover endpoint := 'https://covered.invalid/dsx'

# libcurl strips dot segments (RFC 3986 §5.2.4) unless CURLOPT_PATH_AS_IS is
# set, so a literal-prefix check alone would let '../' escape the ENDPOINT.
statement error
SELECT * FROM delta_share_list(endpoint := 'https://covered.invalid/ds/../other');
----
does not cover

statement error
SELECT * FROM delta_share_list(endpoint := 'https://covered.invalid/ds/%2E%2E/other');
----
does not cover

statement error
SELECT * FROM delta_share_list(endpoint := 'https://covered.invalid/ds/./sub');
----
does not cover

# A dot inside a segment (not a whole segment of just dots) is fine.
statement error
SELECT * FROM delta_share_list(endpoint := 'https://covered.invalid/ds/sub.v1');
----
Could not resolve host: covered.invalid

statement error
SELECT * FROM delta_share_list(endpoint := 'https://nowhere.invalid/ds');
----
no delta_sharing secret's SCOPE matches endpoint := 'https://nowhere.invalid/ds'

statement error
SELECT * FROM delta_share_list(endpoint := NULL);
----
endpoint := must be a non-empty string

# A scheme-only ENDPOINT ('https://' trims to 'https:') must not cover every
# https URL.
statement ok
CREATE SECRET schemeonly (TYPE delta_sharing, ENDPOINT 'https://', BEARER_TOKEN 'x', SCOPE 'https://evil.invalid/');

statement error
SELECT * FROM delta_share_list(endpoint := 'https://evil.invalid/ds');
----
does not cover

statement ok
DROP SECRET schemeonly;

# --- secret := (by name; SCOPE is ignored) ----------------------------------

statement ok
CREATE SECRET named (TYPE delta_sharing, ENDPOINT 'https://named.invalid/ds', BEARER_TOKEN 'x', SCOPE 'https://somewhere-else.invalid/');

statement error
SELECT * FROM delta_share_list(secret := 'named');
----
Could not resolve host: named.invalid

statement error
SELECT * FROM delta_share_list_all_tables('s', secret := 'named');
----
Could not resolve host: named.invalid

statement error
SELECT * FROM delta_share_list(secret := 'missing');
----
secret := 'missing' does not exist

statement ok
CREATE SECRET plain_http (TYPE http);

statement error
SELECT * FROM delta_share_list(secret := 'plain_http');
----
secret := 'plain_http' is a http secret, not delta_sharing

statement error
SELECT * FROM delta_share_list(secret := '');
----
secret := must be a non-empty string

# Both: chosen by name, then the guard applies to the endpoint
statement error
SELECT * FROM delta_share_list(secret := 'named', endpoint := 'https://covered.invalid/ds');
----
secret 'named' has ENDPOINT 'https://named.invalid/ds', which does not cover endpoint := 'https://covered.invalid/ds'

statement error
SELECT * FROM delta_share_list(secret := 'named', endpoint := 'https://named.invalid/ds/sub');
----
Could not resolve host: named.invalid

statement ok
DROP SECRET plain_http;

statement ok
DROP SECRET named;

statement ok
DROP SECRET covered;

# --- secret := ambiguity between same-name secrets in different storages ----
# Pin DuckDB's own behaviour: a memory secret and a persistent secret sharing
# a name make `secret := 'twin'` ambiguous, since secret := looks up by name
# only (no SCOPE-based tie-break the way the default rule and endpoint :=
# have). This is DuckDB's SecretManager, not our code, refusing to guess.
statement ok
CREATE SECRET twin (TYPE delta_sharing, ENDPOINT 'https://twin-mem.invalid/ds', BEARER_TOKEN 'm');

statement ok
CREATE PERSISTENT SECRET twin (TYPE delta_sharing, ENDPOINT 'https://twin-store.invalid/ds', BEARER_TOKEN 's');

statement error
SELECT * FROM delta_share_list(secret := 'twin');
----
Ambiguity detected

statement ok
DROP TEMPORARY SECRET twin;

statement ok
DROP PERSISTENT SECRET twin;

# --- delta_share_read / delta_share_change_data_feed ------------------------

statement ok
CREATE SECRET reader (TYPE delta_sharing, ENDPOINT 'https://reader.invalid/ds', BEARER_TOKEN 'r', SCOPE 'https://reader.invalid/ds');

statement ok
CREATE SECRET other (TYPE delta_sharing, ENDPOINT 'https://other.invalid/ds', BEARER_TOKEN 'o', SCOPE 'https://other.invalid/ds');

statement error
SELECT * FROM delta_share_read('s', 'sc', 't');
----
2 delta_sharing secrets are scoped and none is unscoped (other, reader)

statement error
SELECT * FROM delta_share_read('s', 'sc', 't', secret := 'reader');
----
Could not resolve host: reader.invalid

statement error
SELECT * FROM delta_share_read('s', 'sc', 't', endpoint := 'https://other.invalid/ds');
----
Could not resolve host: other.invalid

statement error
SELECT * FROM delta_share_read('s', 'sc', 't', TIMESTAMP '2026-01-01 00:00:00', secret := 'reader');
----
Could not resolve host: reader.invalid

statement error
SELECT * FROM delta_share_change_data_feed('s', 'sc', 't', 0, secret := 'reader');
----
Could not resolve host: reader.invalid

statement error
SELECT * FROM delta_share_change_data_feed('s', 'sc', 't', endpoint := 'https://other.invalid/ds');
----
Could not resolve host: other.invalid

statement ok
DROP SECRET reader;

statement ok
DROP SECRET other;
